import requests
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, filters, ContextTypes

CHAVE_TMDB = "CHAVE DO TMDB"
TOKEN_TELEGRAM = "CHAVE DO TELEGRAM"
URL_TMDB = "https://api.themoviedb.org/3"

def buscar_filme_no_tmdb(nome):
    nome = nome.strip()
    params = {"api_key": CHAVE_TMDB, "query": nome, "language": "pt-BR"}
    r = requests.get(f"{URL_TMDB}/search/movie", params=params)
    print("Procurei por:", nome, "Status:", r.status_code)
    resposta = r.json()
    print("TMDB achou:", resposta.get("total_results", 0), "filmes")

    lista = resposta.get("results", [])
    if not lista:
        print("Resposta completa:", resposta)
        return None

    filme = lista[0]
    titulo = filme.get("title", "Sem titulo")
    sinopse = filme.get("overview") or "Sem sinopse"
    nota = filme.get("vote_average", 0)
    return f"🎬 *{titulo}*\n⭐ Nota: {nota}\n\n{sinopse}"

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Olá! Me manda o nome de um filme que eu procuro pra você! 🍿")

async def procurar(update: Update, context: ContextTypes.DEFAULT_TYPE):
    nome = update.message.text
    resultado = buscar_filme_no_tmdb(nome)
    if resultado:
        await update.message.reply_text(resultado, parse_mode="Markdown")
    else:
        await update.message.reply_text("Não achei esse filme, tenta outro nome 😢")

app = ApplicationBuilder().token(TOKEN_TELEGRAM).build()
app.add_handler(CommandHandler("start", start))
app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, procurar))
print("Bot ligado!")
app.run_polling()
